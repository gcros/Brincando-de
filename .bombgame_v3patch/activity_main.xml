<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg"
    android:overScrollMode="never">

    <LinearLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TACTICAL DEVICE"
                    android:textColor="@color/text"
                    android:textSize="24sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OBJECTIVE SIMULATOR"
                    android:textColor="@color/muted"
                    android:textSize="10sp"
                    android:letterSpacing="0.15"/>
            </LinearLayout>

            <Button
                android:id="@+id/siteButton"
                android:layout_width="86dp"
                android:layout_height="50dp"
                android:text="SITE A"
                android:textStyle="bold"
                android:textColor="@color/accent"
                android:background="@drawable/btn_dark"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/devicePanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/panel"
            android:padding="14dp"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AGUARDANDO CÓDIGO"
                android:textColor="@color/accent"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/display"
                android:padding="12dp"
                android:layout_marginTop="10dp">

                <TextView
                    android:id="@+id/timerText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="00:40.0"
                    android:textColor="@color/digit"
                    android:textSize="54sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:includeFontPadding="false"/>

                <TextView
                    android:id="@+id/codeText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="_ _ _ _ _ _ _"
                    android:textColor="@color/accent"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:letterSpacing="0.08"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <GridLayout
                android:id="@+id/keypad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:rowCount="4"
                android:useDefaultMargins="true"
                android:layout_marginTop="10dp">

                <Button android:id="@+id/k1" style="@style/KeyButton" android:text="1"/>
                <Button android:id="@+id/k2" style="@style/KeyButton" android:text="2"/>
                <Button android:id="@+id/k3" style="@style/KeyButton" android:text="3"/>
                <Button android:id="@+id/k4" style="@style/KeyButton" android:text="4"/>
                <Button android:id="@+id/k5" style="@style/KeyButton" android:text="5"/>
                <Button android:id="@+id/k6" style="@style/KeyButton" android:text="6"/>
                <Button android:id="@+id/k7" style="@style/KeyButton" android:text="7"/>
                <Button android:id="@+id/k8" style="@style/KeyButton" android:text="8"/>
                <Button android:id="@+id/k9" style="@style/KeyButton" android:text="9"/>
                <Button android:id="@+id/kClear" style="@style/KeyButton" android:text="CLR" android:textSize="14sp"/>
                <Button android:id="@+id/k0" style="@style/KeyButton" android:text="0"/>
                <Button android:id="@+id/kBack" style="@style/KeyButton" android:text="⌫" android:textSize="18sp"/>
            </GridLayout>

            <Button
                android:id="@+id/armButton"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:text="ARMAR / PLANTAR"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#161006"
                android:background="@drawable/btn_arm"
                android:enabled="false"
                android:layout_marginTop="10dp"/>

            <LinearLayout
                android:id="@+id/defusePanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="12dp">

                <ProgressBar
                    android:id="@+id/defuseProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:max="1000"
                    android:progress="0"
                    android:progressTint="@color/safe"/>

                <TextView
                    android:id="@+id/defuseInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Segure o botão até completar"
                    android:textColor="@color/muted"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:layout_marginTop="5dp"/>

                <Button
                    android:id="@+id/defuseButton"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:text="SEGURE PARA DESARMAR"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="#07130C"
                    android:background="@drawable/btn_defuse"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp"
            android:padding="8dp"
            android:background="@drawable/panel">

            <CheckBox
                android:id="@+id/kitCheck"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Kit de desarme (5 s)"
                android:textColor="@color/text"
                android:buttonTint="@color/accent"/>

            <Button
                android:id="@+id/timeButton"
                android:layout_width="94dp"
                android:layout_height="46dp"
                android:text="40 SEG"
                android:textColor="@color/text"
                android:background="@drawable/btn_dark"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="210dp"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="@drawable/panel">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PAINEL TÁTICO"
                android:textColor="@color/accent"
                android:textStyle="bold"
                android:textSize="14sp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_dark"
                    android:gravity="center"
                    android:text="🎛️\nGAIN"
                    android:textColor="@color/text"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <Space android:layout_width="8dp" android:layout_height="1dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_dark"
                    android:gravity="center"
                    android:text="🪢\nLINK"
                    android:textColor="@color/text"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <Space android:layout_width="8dp" android:layout_height="1dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_dark"
                    android:gravity="center"
                    android:text="🔌\nPOWER"
                    android:textColor="@color/text"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_dark"
                    android:gravity="center"
                    android:text="SAFE"
                    android:textColor="@color/safe"
                    android:textStyle="bold"/>

                <Space android:layout_width="8dp" android:layout_height="1dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_dark"
                    android:gravity="center"
                    android:text="ARMED"
                    android:textColor="@color/accent"
                    android:textStyle="bold"/>

                <Space android:layout_width="8dp" android:layout_height="1dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_dark"
                    android:gravity="center"
                    android:text="BYPASS"
                    android:textColor="@color/text"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="● POWER"
                    android:textColor="@color/safe"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="● SIGNAL"
                    android:textColor="@color/accent"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="● LOCK"
                    android:textColor="@color/danger"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/scoreText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ATACANTES  0   ×   0  DEFENSORES"
            android:textColor="@color/text"
            android:textSize="17sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/resetButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="NOVA RODADA"
                android:textColor="@color/text"
                android:background="@drawable/btn_dark"/>

            <Space android:layout_width="8dp" android:layout_height="1dp"/>

            <Button
                android:id="@+id/resetScoreButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="ZERAR PLACAR"
                android:textColor="@color/text"
                android:background="@drawable/btn_dark"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Simulador para partidas entre amigos • sem função de dispositivo real"
            android:textColor="@color/muted"
            android:textSize="10sp"
            android:gravity="center"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"/>
    </LinearLayout>
</ScrollView>
